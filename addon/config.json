{
  "name": "Emulated HUE (Fork)",
  "version": "0.3.9",
  "image": "ghcr.io/kindofnerdy/emulated-hue",
  "slug": "emulated_hue_fork",
  "description": "Hue Emulation for Home Assistant (fork: lowest free light ID, label filter)",
  "url": "https://github.com/KindOfNerdy/emulated-hue",
  "arch": ["aarch64", "amd64"],
  "stage": "stable",
  "startup": "application",
  "boot": "auto",
  "init": false,
  "host_network": true,
  "homeassistant_api": true,
  "map": [
    {
      "type": "homeassistant_config",
      "read_only": false,
      "path": "/config"
    }
  ],
  "options": {
    "verbose": false
  },
  "schema": {
    "http_port": "int?",
    "https_port": "int?",
    "use_default_ports_for_discovery": "bool?",
    "include_labels": "str?",
    "verbose": "bool"
  }
}
